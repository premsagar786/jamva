# SecureID — Environment Variables
# Copy to .env and adjust for your environment. Never commit .env with real secrets.

# === Database (PostgreSQL) ===
DATABASE_URL=jdbc:postgresql://localhost:5432/secureid
DATABASE_NAME=secureid
DATABASE_USERNAME=secureid
DATABASE_PASSWORD=secureid
POSTGRES_PORT=5432

# === Redis ===
REDIS_HOST=localhost
REDIS_PORT=6379

# === JWT ===
# HS256 dev secret must be >=32 chars (256 bits). For RS256 prod use JWT_PRIVATE_KEY / JWT_PUBLIC_KEY.
JWT_SECRET=change-me-in-production-must-be-at-least-32-chars-long-secure
JWT_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# === CORS & Frontend ===
# Comma-separated allowlist, never use * with allowCredentials=true
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000

# === OAuth2 Google ===
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# === Mail (MailHog for local dev) ===
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=no-reply@secureid.local
MAIL_USERNAME=
MAIL_PASSWORD=
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025

# === API & Spring ===
API_PORT=8080
SPRING_PROFILES_ACTIVE=default

# === Rate Limit & Lockout (optional overrides) ===
# secureid.rate-limit.login=5
# secureid.rate-limit.register=3
# secureid.lockout.max-attempts=5

# === Optional: Production ===
# SPRING_PROFILES_ACTIVE=prod
# DATABASE_URL=jdbc:postgresql://prod-host:5432/secureid
# JWT_PRIVATE_KEY= (PEM for RS256)
# JWT_PUBLIC_KEY= (PEM)
